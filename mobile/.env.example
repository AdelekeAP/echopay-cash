# The dev machine LAN IP where echopay-cash/backend is running on :8100.
# Get this with: hostname -I on Linux, ipconfig getifaddr en0 on macOS.
# Expo Go on a physical phone CANNOT reach localhost.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.42:8100

# Mono public key (Mono Connect Widget — safe to expose in the client bundle).
# The Mono SECRET key (mono-sec-key for NIN/BVN lookup) is server-only and
# must NEVER appear here — it lives in echopay-cash/backend/.env when the
# backend lands. See services/mono.ts for the proxy pattern.
EXPO_PUBLIC_MONO_PUBLIC_KEY=test_pk_xxxxxxxxxxxxxxxxxxx
