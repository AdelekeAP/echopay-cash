# EchoPay Cash backend — :8100
DATABASE_URL=sqlite:///./echopay.db

# CORS — comma-separated list of allowed mobile / admin origins
CORS_ORIGINS=http://localhost:8081,http://localhost:5173,http://localhost:19006

# Voice services (existing :8000 stack — external dependency)
VOICE_BASE_URL=http://localhost:8000

# Shared secret for internal proxy JWT (voice_proxy → :8000)
SHARED_INTERNAL_SECRET=change-me

# Squad sandbox — Leke fills these as part of feat/backend-squad
SQUAD_BASE_URL=https://sandbox-api-d.squadco.com
SQUAD_SECRET_KEY=
SQUAD_MERCHANT_ID=ECHOPAYCASH

# Mono — see services/mono.ts on the client. NEVER expose in mobile bundle.
MONO_SECRET_KEY=

# OpenAI Whisper API key — for voice transcription via /auth/voice-signup.
# Get from https://platform.openai.com/api-keys
# Demo bypass: leave empty AND set VOICE_DEMO_MODE=true to skip Whisper
# entirely (always transcribes as "mama risikat").
OPENAI_API_KEY=

# Demo-day insurance flag — bypasses both Whisper and Squad calls when
# external services are unavailable. App still works end-to-end via
# seed.py data. Default false.
VOICE_DEMO_MODE=false

# Path C voice-biometric demo mode for /api/v1/voice/biometrics/* proxy.
# When true, the proxy returns synthetic-pass responses without calling
# the :8000 voice service. Maps to PRD §11.5 "pre-record fallback"
# risk mitigation. Default true for demo-day safety; flip to false
# AFTER :8000 reachability is verified at dress rehearsal.
VOICE_BIOMETRIC_DEMO_MODE=true
VOICE_BIOMETRIC_SERVICE_URL=http://localhost:8000
VOICE_BIOMETRIC_TIMEOUT_SECONDS=10

# ============================================================
# === DEMO-MODE DEFAULTS (safe for stage) ====================
# ============================================================
# Both VOICE_DEMO_MODE and VOICE_BIOMETRIC_DEMO_MODE above default
# true so the demo runs without external service dependencies:
#
#   VOICE_DEMO_MODE=true            — hardcoded transcript "send five
#                                     thousand to iya tope" bypasses
#                                     the Whisper API entirely.
#
#   VOICE_BIOMETRIC_DEMO_MODE=true  — synthetic-pass response bypasses
#                                     the :8000 ECAPA-TDNN service.
#
# When you're ready for live mode (post-hackathon production rollout),
# flip BOTH to false and verify before deploy:
#   - OpenAI Whisper API key valid + reachable (set OPENAI_API_KEY)
#   - :8000 voice biometric service running and ECAPA model loaded
#   - VOICE_BIOMETRIC_SERVICE_URL points at the right host
#
# Run the integration smoke test before flipping in production:
#   curl -X POST http://localhost:8100/voice/intent \
#        -F "audio=@test.m4a"
#   curl -X POST http://localhost:8100/api/v1/voice/biometrics/verify \
#        -H "account-number: 0123456789" \
#        -F "audio=@test.m4a"
# Both should return real (non-synthetic) responses from upstream.
# ============================================================
